								tegra_sinterface = "serial_c";
								vc_id = "3";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								dynamic_pixel_bit_depth = "16";
								csi_pixel_bit_depth = "16";
								mode_type = "yuv";
								pixel_phase = "uyvy";
								active_w = "1920";
								active_h = "1080";
								readout_orientation = "0";
								line_length = "2200";
								inherent_gain = "1";
								pix_clk_hz = "150000000";
								serdes_pix_clk_hz = "350000000";
								gain_factor = "16";
								min_gain_val = "16";
								max_gain_val = "356";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								framerate_factor = "1000000";
								min_framerate = "30000000";
								max_framerate = "30000000";
								step_framerate = "1";
