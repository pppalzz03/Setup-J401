/dts-v1/;

/ {
	overlay-name = "J401 J9 2-lane OFFLINE DRAFT";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = "nvidia,p3768-0000+p3767-0000\0nvidia,p3768-0000+p3767-0001\0nvidia,p3768-0000+p3767-0003\0nvidia,p3768-0000+p3767-0004\0nvidia,p3768-0000+p3767-0005\0nvidia,p3768-0000+p3767-0000-super\0nvidia,p3768-0000+p3767-0001-super\0nvidia,p3768-0000+p3767-0003-super\0nvidia,p3768-0000+p3767-0004-super\0nvidia,p3768-0000+p3767-0005-super";

	fragment@0 {
		target-path = "/";

		__overlay__ {

			tegra-capture-vi {
				num-channels = <0x04>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							vc-id = <0x00>;
							port-index = <0x02>;
							bus-width = <0x02>;
							remote-endpoint = <0x01>;
							phandle = <0x06>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							vc-id = <0x01>;
							port-index = <0x02>;
							bus-width = <0x02>;
							remote-endpoint = <0x02>;
							phandle = <0x08>;
						};
					};

					port@2 {
						reg = <0x02>;

						endpoint {
							vc-id = <0x02>;
							port-index = <0x02>;
							bus-width = <0x02>;
							remote-endpoint = <0x03>;
							phandle = <0x0a>;
						};
					};

					port@3 {
						reg = <0x03>;

						endpoint {
							vc-id = <0x03>;
							port-index = <0x02>;
							bus-width = <0x02>;
							remote-endpoint = <0x04>;
							phandle = <0x0c>;
						};
					};
				};
			};

			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				num_csi_lanes = <0x02>;
				max_lane_speed = <0x16e360>;
				min_bits_per_pixel = <0x0a>;
				vi_peak_byte_per_pixel = <0x02>;
				vi_bw_margin_pct = <0x19>;
				max_pixel_rate = <0x7270e0>;
				isp_peak_byte_per_pixel = <0x05>;
				isp_bw_margin_pct = <0x19>;

				modules {

					module0 {
						badge = "cam0_position";
						position = "position";
						orientation = "1";

						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/cam_0@1a";
						};
					};

					module1 {
						badge = "cam1_position";
						position = "position";
						orientation = "1";

						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/cam_1@1b";
						};
					};

					module2 {
						badge = "cam2_position";
						position = "position";
						orientation = "1";

						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/cam_2@1c";
						};
					};

					module3 {
						badge = "cam3_position";
						position = "position";
						orientation = "1";

						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/cam_3@1d";
						};
					};
				};
			};

			bus@0 {

				host1x@13e00000 {

					nvcsi@15a00000 {
						num-channels = <0x04>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						channel@0 {
							reg = <0x00>;

							ports {
								#address-cells = <0x01>;
								#size-cells = <0x00>;

								port@0 {
									reg = <0x00>;

									endpoint@0 {
										port-index = <0x02>;
										bus-width = <0x02>;
										remote-endpoint = <0x05>;
										phandle = <0x10>;
									};
								};

								port@1 {
									reg = <0x01>;

									endpoint@1 {
										remote-endpoint = <0x06>;
										phandle = <0x01>;
									};
								};
							};
						};

						channel@1 {
							reg = <0x01>;

							ports {
								#address-cells = <0x01>;
								#size-cells = <0x00>;

								port@0 {
									reg = <0x00>;

									endpoint@2 {
										port-index = <0x02>;
										bus-width = <0x02>;
										remote-endpoint = <0x07>;
										phandle = <0x0f>;
									};
								};

								port@1 {
									reg = <0x01>;

									endpoint@3 {
										remote-endpoint = <0x08>;
										phandle = <0x02>;
									};
								};
							};
						};

						channel@2 {
							reg = <0x02>;

							ports {
								#address-cells = <0x01>;
								#size-cells = <0x00>;

								port@0 {
									reg = <0x00>;

									endpoint@4 {
										port-index = <0x02>;
										bus-width = <0x02>;
										remote-endpoint = <0x09>;
										phandle = <0x0e>;
									};
								};

								port@1 {
									reg = <0x01>;

									endpoint@5 {
										remote-endpoint = <0x0a>;
										phandle = <0x03>;
									};
								};
							};
						};

						channel@3 {
							reg = <0x03>;

							ports {
								#address-cells = <0x01>;
								#size-cells = <0x00>;

								port@0 {
									reg = <0x00>;

									endpoint@6 {
										port-index = <0x02>;
										bus-width = <0x02>;
										remote-endpoint = <0x0b>;
										phandle = <0x0d>;
									};
								};

								port@1 {
									reg = <0x01>;

									endpoint@7 {
										remote-endpoint = <0x0c>;
										phandle = <0x04>;
									};
								};
							};
						};
					};
				};

				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					mux-gpios = <0xffffffff 0x13 0x00>;
					i2c-parent = <0xffffffff>;

					i2c@0 {

						rbpcv2_imx219_a@10 {
							status = "disabled";
						};
					};

					i2c@1 {
						status = "okay";
						reg = <0x01>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						rbpcv2_imx219_c@10 {
							status = "disabled";
						};

						max96712_1@6b {
							status = "okay";
							compatible = "nvidia,max96712_1";
							reg = <0x6b>;
						};

						cam_3@1d {
							status = "okay";
							compatible = "sensing,sgx-yuv-gmsl2-3";
							reg = <0x1d>;
							def_addr = <0x34>;
							devnode = "video3";
							physical_w = "15.0";
							physical_h = "12.5";
							sensor_model = "sgx-yuv-gmsl2";
							post_crop_frame_drop = "0";
							use_decibel_gain = "false";
							use_sensor_mode_id = "true";
							clocks = <0xffffffff 0x24 0xffffffff 0x24>;
