[Unit]
Description=SENSING camera live view %i on the Jetson monitor
After=sensing-camera-load.service graphical.target
ConditionPathExists=/dev/%i

[Service]
Type=simple
# One instance per camera: sensing-stream@video0 ... sensing-stream@video3
# (/dev/videoN = GMSL port N). Start/stop each camera on its own:
#   sudo systemctl start sensing-stream@video1
#   sudo systemctl stop  sensing-stream@video1
# Runs common/capture/stream.sh as root so its internal sudo needs no password.
# SUDO_UID must be the uid of the user logged in on the Jetson desktop
# (check with: id -u). stream.sh uses it to find /run/user/<uid>/gdm/Xauthority.
Environment=SUDO_UID=1000
Environment=DISPLAY=:1
ExecStart=/bin/bash /usr/local/lib/sensing-j401/stream.sh /dev/%i
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
