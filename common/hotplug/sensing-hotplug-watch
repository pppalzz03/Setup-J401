#!/usr/bin/python3
"""Watch the GMSL link lock of the 4 MAX96712 ports and reload the SENSING
camera stack when a camera cable is plugged back in.

GMSL2 re-locks by itself when the cable comes back, but the camera was powered
off over the coax, so the serializer and sensor lost the setup done at probe.
The driver does not notice, so the stream stays frozen. This watcher detects
that and reloads the sensor driver. The driver serves all 4 ports, so every
camera stream stops during the reload; the watcher remembers which streams
were running and starts exactly those again.

  cable lost on port N  -> stop sensing-stream@videoN (if running)
  cable back, stable    -> stop all running streams -> rmmod sgx_yuv_gmsl2
                        -> systemctl restart sensing-camera-load.service
                        -> check /dev/videoN of each stream
                        -> start the streams that were running

Settings (environment, see sensing-hotplug-watch.service):
  STREAM_UNITS  pattern of camera stream services (default sensing-stream@*.service).
                Instance name is the video node: sensing-stream@video1 uses
                /dev/video1 = port 1.
  APP_SERVICE   extra service(s) that use the cameras, space separated; stopped
                and restarted the same way if running. Empty = none.
  POLL          seconds between lock checks (default 1)
  STABLE        seconds the lock must stay unchanged before acting (default 3)
  RETRY         seconds before retrying a failed reconnect (default 15)
  MAX_RETRY     failed reconnects in a row before waiting for the next cable
                change (default 3)
  START_GAP     seconds between starting streams after reconnect (default 3)
  UNLOAD_MODULES  modules removed before reload, in order (default sgx_yuv_gmsl2)

  --dry-run     log what would happen, do not stop/unload/reload anything
"""
import glob
import os
import re
import subprocess
import sys
import time

BUS = '9'
DES = 0x6b
DES_ID = 0x20
LOCK_REGS = (0x1a, 0x0a, 0x0b, 0x0c)       # port 0..3, bit 0x08 = locked
LOADER = 'sensing-camera-load.service'
# Only the sensor driver is reloaded. max96712 does not unload cleanly (it is left
# at refcount -1 until reboot) and the deserializer keeps power while the cable
# is out; the loader re-applies its 2-lane setup anyway.
MODULES = tuple(os.environ.get('UNLOAD_MODULES', 'sgx_yuv_gmsl2').split())

STREAM_UNITS = os.environ.get('STREAM_UNITS', 'sensing-stream@*.service').strip()
APPS = os.environ.get('APP_SERVICE', '').split()
POLL = float(os.environ.get('POLL', '1'))
STABLE = float(os.environ.get('STABLE', '3'))
RETRY = float(os.environ.get('RETRY', '15'))
MAX_RETRY = int(os.environ.get('MAX_RETRY', '3'))
# Wait between starting streams so each one sees the earlier ones already open
# (stream.sh skips the all-link 2-lane setup when another camera is streaming).
START_GAP = float(os.environ.get('START_GAP', '3'))
DRY_RUN = '--dry-run' in sys.argv[1:]
DEV = os.environ.get('DEV_DIR', '/dev')    # for tests


def log(msg):
    print(msg, flush=True)


def query(cmd, timeout=30):
    """Read-only command, runs in dry run too. Returns (ok, output)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return False, 'timeout after %ds' % timeout
    return p.returncode == 0, (p.stdout + p.stderr).strip()


def run(cmd, timeout=30):
    """Command that changes something; only logged in dry run."""
    if DRY_RUN:
        log('  dry run: ' + ' '.join(cmd))
        return True, ''
    return query(cmd, timeout)


def read(register):
    try:
        p = subprocess.run(['i2ctransfer', '-f', '-y', BUS, 'w2@' + hex(DES),
                            hex(register >> 8), hex(register & 255), 'r1'],
                           capture_output=True, text=True, timeout=3)
    except subprocess.TimeoutExpired:
        return None
    return int(p.stdout.strip(), 16) if p.returncode == 0 else None


def locked_ports():
    values = [read(r) for r in LOCK_REGS]
    if any(v is None for v in values):
        return None
    return frozenset(p for p, v in enumerate(values) if v & 8)


def fmt(ports):
    return sorted(ports) if ports else 'none'


def stream_unit(port):
    return STREAM_UNITS.replace('*', 'video%d' % port)


def video_of(unit):
    m = re.search(r'@(video\d+)\.service$', unit)
    return os.path.join(DEV, m.group(1)) if m else None


def is_active(unit):
    return query(['systemctl', 'is-active', '--quiet', unit])[0]


def running_units():
    """Camera services that are running now."""
    units = []
    if STREAM_UNITS:
        out = query(['systemctl', 'list-units', '--type=service', '--state=active,activating',
                     '--plain', '--no-legend', STREAM_UNITS])[1]
        units = [line.split()[0] for line in out.splitlines() if line.strip()]
    return units + [a for a in APPS if is_active(a)]


def stop(units):
    for u in units:
        ok, out = run(['systemctl', 'stop', u])
        log('  stop %s: %s' % (u, 'ok' if ok else out))


def start(units):
    for i, u in enumerate(sorted(units)):
        if i and not DRY_RUN:
            time.sleep(START_GAP)
        ok, out = run(['systemctl', 'start', u])
        log('  start %s: %s' % (u, 'ok' if ok else out))


def reconnect(resume):
    """Reload the sensor driver. resume: set of units to start afterwards (updated)."""
    now = running_units()
    resume.update(now)
    stop(now)
    for m in MODULES:
        ok, out = run(['rmmod', m], timeout=20)
        if not ok and 'not currently loaded' not in out and 'does not exist' not in out:
            users = query(['fuser'] + sorted(glob.glob(os.path.join(DEV, 'video*'))))[1]
            log('  rmmod %s failed: %s%s' % (m, out, ('; in use: ' + users) if users else ''))
            return False
    ok, out = run(['systemctl', 'restart', LOADER], timeout=90)
    if not ok:
        log('  restart %s failed; see journalctl -u %s' % (LOADER, LOADER))
        return False
    for line in query(['journalctl', '-u', LOADER, '-n', '12', '--no-pager', '-o', 'cat'])[1].splitlines():
        if line.startswith(('port ', 'GMSL', 'SENSING', 'MAX96712', 'WARN')):
            log('  loader: ' + line)
    if not DRY_RUN:
        missing = [v for v in (video_of(u) for u in resume) if v and not os.path.exists(v)]
        if missing or not glob.glob(os.path.join(DEV, 'video*')):
            log('  missing after reload: %s' % (' '.join(missing) or '/dev/video*'))
            return False
    start(resume)
    resume.clear()
    return True


def main():
    if read(0x4a) != DES_ID:
        sys.exit('Expected MAX96712 not found on camera bus ' + BUS)
    current = locked_ports()
    log('sensing-hotplug-watch started%s: locked ports %s, streams %s'
        % (' (dry run)' if DRY_RUN else '', fmt(current or ()),
           ' '.join(running_units()) or 'none running'))

    pending = None          # (ports, since) waiting to become stable
    acted = current or frozenset()   # state after the last action
    dropped = set()         # ports that lost the cable since the last action
    resume = set()          # services stopped by us, to start after reconnect
    failures = 0
    next_retry = 0.0

    def attempt():
        nonlocal current, acted, failures, next_retry
        if reconnect(resume):
            log('reconnect done')
            failures = 0
        else:
            failures += 1
            if failures >= MAX_RETRY:
                failures = 0
                log('reconnect gave up after %d tries; unplug and replug the cable, or reboot'
                    % MAX_RETRY)
                if resume:
                    log('  not restarted: %s' % ' '.join(sorted(resume)))
                    resume.clear()
            else:
                next_retry = time.monotonic() + RETRY
                log('reconnect failed (%d/%d); retry in %.0fs' % (failures, MAX_RETRY, RETRY))
        # the reload itself switches links; start again from what is locked now
        current = locked_ports() or frozenset()
        acted = current

    while True:
        time.sleep(POLL)
        now = locked_ports()
        if now is None:
            continue        # I2C busy or error; try again next poll
        t = time.monotonic()
        if now != current:
            log('link change: locked ports %s -> %s' % (fmt(current), fmt(now)))
            lost = (current or frozenset()) - now
            if lost:
                log('  cable lost on port %s' % fmt(lost))
                dropped.update(lost)
                gone = [u for u in (stream_unit(p) for p in sorted(lost)) if is_active(u)]
                resume.update(gone)
                stop(gone)
            current = now
            pending = (now, t)
            failures = 0
            continue
        if pending and t - pending[1] >= STABLE:
            ports = pending[0]
            pending = None
            back = (ports - acted) | (ports & dropped)
            dropped.clear()
            acted = ports
            if back:
                log('cable back on port %s, stable %.0fs: reconnecting' % (fmt(back), STABLE))
                attempt()
            elif not ports:
                log('no camera link; waiting for a cable')
        elif failures and t >= next_retry and current:
            log('retrying reconnect (%d/%d)' % (failures + 1, MAX_RETRY))
            attempt()


if __name__ == '__main__':
    main()
